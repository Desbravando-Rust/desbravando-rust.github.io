---
layout: null
sitemap: false
---
{%- comment -%}
  Lista de posts para CTA externo do livro (título, resumo, link).
  Mesma fonte do feed.xml: site.pages em posts/, resumo = 1º parágrafo real.
  Post novo entra sozinho no próximo build.
{%- endcomment -%}
{%- assign blog_posts = site.pages | where_exp: "p", "p.path contains 'posts/'" | sort: "path" | reverse -%}
[
{%- for p in blog_posts %}
  {%- assign lines = p.content | newline_to_br | split: '<br />' -%}
  {%- assign desc = '' -%}
  {%- for line in lines -%}
    {%- assign t = line | strip -%}
    {%- assign c = t | slice: 0, 1 -%}
    {%- if desc == '' and t != '' and c != '#' and c != '!' -%}
      {%- assign desc = t | markdownify | strip_html | strip_newlines | strip -%}
    {%- endif -%}
  {%- endfor %}
  {"title": {{ p.title | jsonify }}, "summary": {{ desc | jsonify }}, "url": {{ p.url | absolute_url | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
